# Supabase (create a free project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used to build OAuth redirect URLs (Google sign-in). Update this to your
# real domain once deployed (e.g. https://biyahe.vercel.app) — no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (for itinerary generation on the Discover page)
ANTHROPIC_API_KEY=

# Google OAuth client (Google Auth Platform console) — same one used for
# Google sign-in below, but also needed here so the server can refresh
# Gmail access tokens directly for the "Connect Gmail" booking sync on
# the Bookings page. See README.md > "Gmail booking sync" for setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pexels (grab a free key at https://www.pexels.com/api/) — used for the
# first 1-2 (curated, professional-quality) Discover destination photos.
# The rest of each gallery fills in from Openverse below, no key needed.
# See README.md > "Discover photos" for setup.
PEXELS_API_KEY=
